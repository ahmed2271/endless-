#!/usr/bin/env python3
"""Stand-in for ORCA 6.0.1 used by the test-suite (the build machine has no ORCA).

It reads the input written by ORCA Studio and writes an ORCA-6-style .out plus the side files
(.xyz, _trj.xyz, .gbw, .hess, .property.txt). Numbers are made up but deterministic.
Triggers (molecule base name contains):  scffail -> SCF fails unless SlowConv/KDIIS present;
optfail -> optimization does not converge unless restarted from a previous geometry;
imag -> one imaginary mode unless the geometry was displaced; crash -> exits with an error.
FAKE_ORCA_SLEEP (seconds, default 0.5) controls the run time.
"""
import math
import os
import re
import subprocess
import sys
import time

Z = {"H": 1, "He": 2, "Li": 3, "Be": 4, "B": 5, "C": 6, "N": 7, "O": 8, "F": 9, "Ne": 10, "Na": 11, "Mg": 12,
     "Al": 13, "Si": 14, "P": 15, "S": 16, "Cl": 17, "Ar": 18, "Br": 35, "I": 53}
MASS = {"H": 1.008, "C": 12.011, "N": 14.007, "O": 15.999, "F": 18.998, "S": 32.06, "Cl": 35.45}


def main():
    if len(sys.argv) < 2 or not os.path.exists(sys.argv[1]):
        print("                                 * O   R   C   A *")
        print("                         Program Version 6.0.1 -  RELEASE  -")
        print(f"ERROR: cannot open input file {sys.argv[1] if len(sys.argv) > 1 else ''}")
        sys.exit(1)
    inp = sys.argv[1]
    base = os.path.splitext(os.path.basename(inp))[0]
    text = open(inp).read()
    kw = []
    for ln in text.splitlines():
        if ln.strip().startswith("!"):
            kw += ln.strip()[1:].split()
    kwl = [k.lower() for k in kw]
    nprocs = int((re.search(r"%pal\s+nprocs\s+(\d+)", text, re.I) or [0, 1])[1])
    m = re.search(r"^\*\s*xyzfile\s+(-?\d+)\s+(\d+)\s+(\S+)", text, re.M | re.I)
    comment = ""
    if m:
        charge, mult, xyz = int(m.group(1)), int(m.group(2)), m.group(3)
        lines = open(xyz).read().splitlines()
        n = int(lines[0].split()[0])
        comment = lines[1]
        atoms = [(l.split()[0], *map(float, l.split()[1:4])) for l in lines[2:2 + n]]
    else:
        m = re.search(r"^\*\s*(xyz|int)\s+(-?\d+)\s+(\d+)\s*\n(.*?)^\*", text, re.M | re.S | re.I)
        charge, mult = int(m.group(2)), int(m.group(3))
        atoms = []
        for l in m.group(4).splitlines():
            p = l.split()
            if p:
                sym = re.match(r"[A-Za-z]+", p[0]).group(0)
                atoms.append((sym, *(float(x) for x in (p[1:4] if m.group(1).lower() == "xyz" else [0, 0, len(atoms)]))))
    sleep = float(os.environ.get("FAKE_ORCA_SLEEP", "0.5"))
    # an MPI-like child process, to test that cancel kills the whole group
    child = subprocess.Popen([sys.executable, "-c", "import time; time.sleep(3600)"]) if nprocs > 1 else None
    out = []
    w = out.append
    w("")
    w("                                 *****************")
    w("                                 * O   R   C   A *")
    w("                                 *****************")
    w("")
    w("                         Program Version 6.0.1 -  RELEASE  -")
    w("")
    w("================================================================================")
    w("                                       INPUT FILE")
    w("================================================================================")
    w(f"NAME = {inp}")
    for i, l in enumerate(text.splitlines(), 1):
        w(f"|{i:3d}> {l}")
    w("|****END OF INPUT****")
    w("================================================================================")
    nel = sum(Z.get(a[0], 6) for a in atoms) - charge
    if (nel % 2) != ((mult - 1) % 2):
        w("")
        w(f"Error : multiplicity ({mult}) is odd and number of electrons ({nel}) is odd -> impossible")
        w("ORCA finished by error termination in Startup")
        flush(base, out, child)
        sys.exit(1)
    if "crash" in base:
        flush(base, out, child)
        sys.exit(2)
    xtb = any(k.startswith("xtb") for k in kwl)
    opt = any(k in ("opt", "looseopt", "tightopt", "optts", "copt", "verytightopt", "normalopt") for k in kwl)
    freq = any(k in ("freq", "numfreq") for k in kwl)
    tddft = "%tddft" in text.lower()
    uks = mult > 1 or "uks" in kwl
    w("")
    w("----------------")
    w("General Settings:")
    w(f" Total Charge           Charge          ....    {charge}")
    w(f" Multiplicity           Mult            ....    {mult}")
    w(f" Number of Electrons    NEL             ....   {nel}")
    w(f" Basis Dimension        Dim             ....   {len(atoms) * 9}")
    w(f" Number of basis functions                   ...   {len(atoms) * 9}")

    scf_fail = "scffail" in base and not any(k in kwl for k in ("slowconv", "kdiis", "veryslowconv"))
    opt_fail = "optfail" in base and "last geometry" not in comment
    imag = "imag" in base and "displaced" not in comment
    e0 = -sum(Z.get(a[0], 6) for a in atoms) * (0.5 if xtb else 4.2) - 0.01 * len(atoms)
    if any("b3lyp" in k for k in kwl):
        e0 -= 0.12
    if "deltascf" in kwl:
        e0 += 0.15          # excited state (ΔSCF)
    if mult == 3:
        e0 += 0.10          # triplet
    geom = [list(a) for a in atoms]
    cycles = 1
    if opt:
        cycles = 3 if not opt_fail else 50
    traj = []
    for c in range(1, cycles + 1):
        if opt:
            w("")
            w("                         *************************************************************")
            w(f"                         *                GEOMETRY OPTIMIZATION CYCLE   {c:2d}            *")
            w("                         *************************************************************")
        cen = [sum(a[i] for a in geom) / len(geom) for i in (1, 2, 3)]
        if opt and c > 1:
            for a in geom:
                for i in (1, 2, 3):
                    a[i] = cen[i - 1] + (a[i] - cen[i - 1]) * 0.995
        traj.append([tuple(a) for a in geom])
        coords(w, geom)
        if scf_fail:
            w("")
            w("                       *****************************************************")
            w("                       *                      ERROR                        *")
            w("                       *        SCF NOT CONVERGED AFTER 125 CYCLES         *")
            w("                       *****************************************************")
            w("")
            w("This wavefunction IS NOT CONVERGED!")
            w("ORCA finished by error termination in SCF")
            time.sleep(sleep)
            flush(base, out, child)
            sys.exit(1)
        E = e0 - 0.001 * c
        scf(w, E, atoms, uks, mult, charge, nel)
        w("")
        w("-------------------------   --------------------")
        w(f"FINAL SINGLE POINT ENERGY      {E:20.12f}")
        w("-------------------------   --------------------")
        if opt and c == cycles and not opt_fail:
            w("")
            w("                    ***********************HURRAY********************")
            w("                    ***        THE OPTIMIZATION HAS CONVERGED     ***")
            w("                    *************************************************")
            w("")
            w("                             *******************************************************")
            w("                             *** FINAL ENERGY EVALUATION AT THE STATIONARY POINT ***")
            w("                             *******************************************************")
            coords(w, geom)
            w(f"FINAL SINGLE POINT ENERGY      {E:20.12f}")
        time.sleep(sleep / cycles)
    if opt_fail:
        w("")
        w("The optimization did not converge but reached the maximum number of")
        w("optimization cycles.")
        w("Please check your results very carefully.")
    trj_text = ""
    for fr in traj:
        trj_text += f"{len(fr)}\nCoordinates from ORCA-job {base} E {E:.12f}\n" + "".join(
            f"  {a[0]:<2s}{a[1]:16.8f}{a[2]:16.8f}{a[3]:16.8f}\n" for a in fr)
    if opt:
        open(f"{base}_trj.xyz", "w").write(trj_text)
    open(f"{base}.xyz", "w").write(f"{len(geom)}\nCoordinates from ORCA-job {base} E {E:.12f}\n" + "".join(
        f"  {a[0]:<2s}{a[1]:16.8f}{a[2]:16.8f}{a[3]:16.8f}\n" for a in geom))
    open(f"{base}.gbw", "wb").write(b"FAKEGBW" * 100)
    if "keepdens" in kwl:
        open(f"{base}.densities", "wb").write(b"FAKEDENS")
    if tddft:
        nroots = int((re.search(r"nroots\s+(\d+)", text, re.I) or [0, 5])[1])
        tdblock(w, nroots, "triplets true" in text.lower())
    if freq:
        freqblock(w, base, geom, E, imag)
    w("")
    w("-------------------------   --------------------")
    w(f"FINAL SINGLE POINT ENERGY      {E:20.12f}")
    w("-------------------------   --------------------")
    w("")
    w("                             ****ORCA TERMINATED NORMALLY****")
    w(f"TOTAL RUN TIME: 0 days 0 hours 0 minutes {int(sleep)} seconds {int((sleep % 1) * 1000)} msec")
    open(f"{base}.property.txt", "w").write(
        "*************************************************\n$Calculation_Status\n   &GeometryIndex 1\n"
        '   &VERSION [&Type "String"] "6.0.1"\n   &STATUS [&Type "String"] "NORMAL TERMINATION"\n$End\n'
        "$SCF_Energy\n   &GeometryIndex 1\n   &ListStatus       LAST\n"
        f'   &SCF_ENERGY [&Type "Double"]      {E:.16e}\n$End\n'
        "$Single_Point_Data\n"
        f'   &FINALENERGY [&Type "Double"]      {E:.16e}\n   &CHARGE [&Type "Integer"] {charge}\n'
        f'   &MULT [&Type "Integer"] {mult}\n$End\n')
    flush(base, out, child)
    sys.exit(0)


def coords(w, geom):
    w("")
    w("---------------------------------")
    w("CARTESIAN COORDINATES (ANGSTROEM)")
    w("---------------------------------")
    for a in geom:
        w(f"  {a[0]:<2s}  {a[1]:14.6f}{a[2]:14.6f}{a[3]:14.6f}")
    w("")


def scf(w, E, atoms, uks, mult, charge, nel):
    w("")
    w("                     *****************************************************")
    w("                     *                     SUCCESS                       *")
    w("                     *           SCF CONVERGED AFTER  12 CYCLES          *")
    w("                     *****************************************************")
    w("")
    w("----------------")
    w("TOTAL SCF ENERGY")
    w("----------------")
    w("")
    w(f"Total Energy       :          {E:.8f} Eh           {E * 27.211386:.5f} eV")
    w("")
    w("Components:")
    w(f"Nuclear Repulsion  :            {9.1 * len(atoms) / 3:.8f} Eh")
    w(f"Electronic Energy  :          {E - 9.1 * len(atoms) / 3:.8f} Eh")
    w(f"E(X)               :          {-0.8 * nel:.8f} Eh       ")
    w(f"E(C)               :          {-0.04 * nel:.8f} Eh       ")
    w(f"E(XC)              :          {-0.84 * nel:.8f} Eh       ")
    w("")
    w("-------------------------   ----------------")
    w(f"Dispersion correction           {-0.0003 * len(atoms):.9f}")
    w("-------------------------   ----------------")
    if uks:
        s = (mult - 1) / 2
        w("")
        w("----------------------")
        w("UHF SPIN CONTAMINATION")
        w("----------------------")
        w("")
        w(f"Expectation value of <S**2>     :     {s * (s + 1) + 0.0042:.6f}")
        w(f"Ideal value S*(S+1) for S={s:.1f}   :     {s * (s + 1):.6f}")
        w(f"Deviation                       :     0.004200")
    w("")
    w("----------------")
    w("ORBITAL ENERGIES")
    w("----------------")
    nb = len(atoms) * 9
    if uks:
        na, nbeta = (nel + mult - 1) // 2, (nel - mult + 1) // 2
        for label, nocc in (("SPIN UP ORBITALS", na), ("SPIN DOWN ORBITALS", nbeta)):
            w(f"                 {label}")
            w("  NO   OCC          E(Eh)            E(eV) ")
            for i in range(nb):
                e = -20 + i * (19.7 / nocc) if i < nocc else 0.02 + 0.1 * (i - nocc)
                w(f"{i:4d}   {1.0 if i < nocc else 0.0:.4f}     {e:12.6f}     {e * 27.2114:12.4f} ")
            w("")
    else:
        nocc = nel // 2
        w("")
        w("  NO   OCC          E(Eh)            E(eV) ")
        for i in range(nb):
            e = -20 + i * (19.7 / nocc) if i < nocc else 0.02 + 0.1 * (i - nocc)
            w(f"{i:4d}   {2.0 if i < nocc else 0.0:.4f}     {e:12.6f}     {e * 27.2114:12.4f} ")
    w("")
    qs = [(-0.3 if a[0] not in ("H",) else 0.15) for a in atoms]
    tot = sum(qs) - charge
    qs = [q - tot / len(qs) for q in qs]
    spin = (mult - 1) / max(1, len(atoms))
    for title, f in (("MULLIKEN", 1.0), ("LOEWDIN", 0.6)):
        w("")
        hdr = f"{title} ATOMIC CHARGES" + (" AND SPIN POPULATIONS" if uks else "")
        w("-" * len(hdr))
        w(hdr)
        w("-" * len(hdr))
        for i, (a, q) in enumerate(zip(atoms, qs)):
            w(f"{i:4d} {a[0]:<2s}:   {q * f:10.6f}" + (f" {spin:10.6f}" if uks else ""))
        w(f"Sum of atomic charges:   {charge:.7f}")
    w("")
    w("                      *****************************")
    w("                      * MAYER POPULATION ANALYSIS *")
    w("                      *****************************")
    w("")
    w("  ATOM       NA         ZA         QA         VA         BVA        FA")
    for i, (a, q) in enumerate(zip(atoms, qs)):
        zz = Z.get(a[0], 6)
        w(f"{i:3d} {a[0]:<2s}     {zz - q:7.4f}    {zz:7.4f}    {q:7.4f}    {1.9:7.4f}    {1.9:7.4f}    {0.0:7.4f}")
    w("")
    w("  Mayer bond orders larger than 0.100000")
    bo = ""
    for i in range(len(atoms)):
        for j in range(i + 1, len(atoms)):
            d = math.dist(atoms[i][1:], atoms[j][1:])
            if d < 1.6:
                bo += f"B({i:3d}-{atoms[i][0]:<2s},{j:3d}-{atoms[j][0]:<2s}) : {max(0.1, 2.2 - d):8.4f} "
    w(bo)
    w("")
    kws = " ".join(l for l in open(sys.argv[1]).read().splitlines() if l.startswith("!")).lower()
    if "hirshfeld" in kws:
        w("------------------")
        w("HIRSHFELD ANALYSIS")
        w("------------------")
        w("")
        w(f"Total integrated alpha density =      {nel / 2:.9f}")
        w(f"Total integrated beta density  =      {nel / 2:.9f}")
        w("")
        w("  ATOM     CHARGE      SPIN    ")
        for i, (a, q) in enumerate(zip(atoms, qs)):
            w(f"{i:4d} {a[0]:<2s}  {q * 0.5:10.6f} {0.0:10.6f}")
        w("")
        w(f"  TOTAL  {charge:10.6f} {mult - 1:10.6f}")
        w("")
    if "mbis" in kws:
        w("------------------------------------------------------------------------------")
        w("                                MBIS ANALYSIS")
        w("------------------------------------------------------------------------------")
        w("Number of iterations              ...           40")
        w("")
        w("  ATOM   CHARGE     POPULATION     SPIN    ")
        for i, (a, q) in enumerate(zip(atoms, qs)):
            w(f"{i:4d} {a[0]:<2s}  {q * 1.8:10.6f}  {Z.get(a[0], 6) - q * 1.8:10.6f}  {0.0:10.6f}")
        w(f"  TOTAL  {charge:10.6f}")
        w("")
    if "chelpg" in kws:
        w("--------------------------------")
        w("CHELPG Charges            ")
        w("--------------------------------")
        for i, (a, q) in enumerate(zip(atoms, qs)):
            w(f"{i:3d}   {a[0]:<2s}  :     {q * 2:10.6f}")
        w("--------------------------------")
        w(f"Total charge:    {charge:.6f}")
        w("--------------------------------")
    w("")
    w("-------------")
    w("DIPOLE MOMENT")
    w("-------------")
    w("                                X                 Y                 Z")
    dz = 0.1 * len(atoms) + 0.5
    w(f"Total Dipole Moment    :      0.000000000       0.000000000       {dz:.9f}")
    w("                        -----------------------------------------")
    w(f"Magnitude (a.u.)       :      {dz:.9f}")
    w(f"Magnitude (Debye)      :      {dz * 2.541746:.9f}")
    w("")
    w(f"Rotational constants in cm-1:    27.123456    14.521234     9.453210")


def tdblock(w, nroots, triplets):
    for mult, label in ((1, "SINGLETS"),) + (((3, "TRIPLETS"),) if triplets else ()):
        w("")
        w("------------------------------------")
        w(f"TD-DFT/TDA EXCITED STATES ({label})")
        w("------------------------------------")
        w("")
        w("the weight of the individual excitations are printed if larger than 1.0e-02")
        w("")
        for s in range(1, nroots + 1):
            ev = 4.0 + 0.5 * s - (0.6 if mult == 3 else 0)
            au = ev / 27.211386
            w(f"STATE {s:2d}:  E=   {au:.6f} au     {ev:7.3f} eV    {ev * 8065.544:8.1f} cm**-1 <S**2> =   "
              f"{0.0 if mult == 1 else 2.0:.6f} Mult {mult}")
            w(f"     4a ->   5a  :     {0.95:.6f} (c= -0.97467943)")
            w(f"     3a ->   6a  :     {0.03:.6f} (c=  0.17320508)")
            w("")
    w("")
    w("----------------------------------------------------------------------------------------------------")
    w("                     ABSORPTION SPECTRUM VIA TRANSITION ELECTRIC DIPOLE MOMENTS")
    w("----------------------------------------------------------------------------------------------------")
    w("     Transition      Energy     Energy  Wavelength fosc(D2)      D2        DX        DY        DZ   ")
    w("                      (eV)      (cm-1)    (nm)                 (au**2)    (au)      (au)      (au)  ")
    w("----------------------------------------------------------------------------------------------------")
    for s in range(1, nroots + 1):
        ev = 4.0 + 0.5 * s
        f = 0.05 * s if s % 2 else 0.0001
        w(f"  0-1A  ->  {s}-1A    {ev:9.6f}   {ev * 8065.544:8.1f}   {1239.84193 / ev:6.1f}   {f:.9f}   "
          f"{f * 10:.5f}   0.00000   0.10000   {f:.5f}")
    w("")
    w("----------------------------------------------------------------------------------------------------")
    w("                     ABSORPTION SPECTRUM VIA TRANSITION VELOCITY DIPOLE MOMENTS")
    w("----------------------------------------------------------------------------------------------------")
    w("  0-1A  ->  1-1A    4.500000   36295.0   275.5   0.999999999   0.00000   0.00000   0.00000   0.00000")
    w("")


def freqblock(w, base, geom, E, imag):
    n = len(geom)
    nf = 3 * n
    freqs = [0.0] * 6 + [400.0 + 3400.0 * i / max(1, nf - 7) for i in range(nf - 6)]
    if n == 2:
        freqs = [0.0] * 5 + [4400.0]
        nf = 6
    if imag and nf > 6:
        freqs[6] = -123.45
    w("")
    w("-----------------------")
    w("VIBRATIONAL FREQUENCIES")
    w("-----------------------")
    w("")
    w("Scaling factor for frequencies =  1.000000000 (already applied!)")
    w("")
    for i, f in enumerate(freqs):
        w(f"{i:6d}:   {f:10.2f} cm**-1" + (" ***imaginary mode***" if f < 0 else ""))
    w("")
    w("-----------")
    w("IR SPECTRUM")
    w("-----------")
    w("")
    w(" Mode   freq       eps      Int      T**2         TX        TY        TZ")
    w("       cm**-1   L/(mol*cm) km/mol    a.u.")
    w("----------------------------------------------------------------------------")
    for i, f in enumerate(freqs):
        if abs(f) < 1e-3:
            continue
        inten = 10 + (i * 7) % 60
        w(f"{i:4d}:   {f:7.2f}   {inten / 5000:.6f}   {inten:6.2f}  {inten / 25000:.6f}  ( 0.000000 -0.048217 -0.000000)")
    w("")
    zpe = sum(f for f in freqs if f > 0) / 2 / 219474.63
    T = 298.15
    w("--------------------------")
    w(f"THERMOCHEMISTRY AT {T:.2f}K")
    w("--------------------------")
    w("")
    w(f"Temperature         ... {T:.2f} K")
    w("Pressure            ... 1.00 atm")
    w("")
    w("Summary of contributions to the inner energy U:")
    w(f"Electronic energy                ...    {E:.8f} Eh")
    w(f"Zero point energy                ...      {zpe:.8f} Eh      {zpe * 627.5095:.2f} kcal/mol")
    w(f"Thermal vibrational correction   ...      0.00000282 Eh       0.00 kcal/mol")
    w(f"Thermal rotational correction    ...      0.00141627 Eh       0.89 kcal/mol")
    w(f"Thermal translational correction ...      0.00141627 Eh       0.89 kcal/mol")
    w("-----------------------------------------------------------------------")
    U = E + zpe + 0.00283536
    w(f"Total thermal energy                    {U:.8f} Eh")
    w("")
    w("Summary of corrections to the electronic energy:")
    w(f"Total thermal correction                  0.00283536 Eh       1.78 kcal/mol")
    w(f"Non-thermal (ZPE) correction              {zpe:.8f} Eh      {zpe * 627.5095:.2f} kcal/mol")
    w("-----------------------------------------------------------------------")
    w(f"Total correction                          {zpe + 0.00283536:.8f} Eh")
    w("")
    w(f"Total free energy                 ...    {U:.8f} Eh")
    w(f"Thermal Enthalpy correction       ...      0.00094421 Eh       0.59 kcal/mol")
    w("-----------------------------------------------------------------------")
    H = U + 0.00094421
    w(f"Total Enthalpy                    ...    {H:.8f} Eh")
    w("")
    w(f"Electronic entropy                ...      0.00000000 Eh      0.00 kcal/mol")
    w(f"Vibrational entropy               ...      0.00000353 Eh      0.00 kcal/mol")
    w(f"Rotational entropy                ...      0.00525091 Eh      3.30 kcal/mol")
    w(f"Translational entropy             ...      0.01643521 Eh     10.31 kcal/mol")
    w("-----------------------------------------------------------------------")
    TS = 0.02168965
    w(f"Final entropy term                ...      {TS:.8f} Eh     13.61 kcal/mol")
    w("")
    w(f"Total enthalpy                    ...    {H:.8f} Eh")
    w(f"Total entropy correction          ...     {-TS:.8f} Eh    -13.61 kcal/mol")
    w("-----------------------------------------------------------------------")
    G = H - TS
    w(f"Final Gibbs free energy         ...    {G:.8f} Eh")
    w("")
    w(f"G-E(el)                           ...      {G - E:.8f} Eh      {(G - E) * 627.5095:.2f} kcal/mol")
    # .hess
    hs = ["", "$orca_hessian_file", "", "$vibrational_frequencies", str(nf)]
    hs += [f"{i:5d}   {f:12.6f}" for i, f in enumerate(freqs)]
    hs += ["", "$normal_modes", f"{nf} {nf}"]
    for c0 in range(0, nf, 5):
        cols = list(range(c0, min(nf, c0 + 5)))
        hs.append("        " + "".join(f"{c:12d}" for c in cols))
        for r in range(nf):
            hs.append(f"{r:6d}  " + "".join(f"{(0.3 if (r % 3 == 2 and c == 6) else 0.0):12.6f}" for c in cols))
    hs += ["", "$atoms", str(n)]
    for a in geom:
        hs.append(f" {a[0]:<2s}  {MASS.get(a[0], 12.0):10.5f}  {a[1] / 0.529177210903:14.8f} "
                  f"{a[2] / 0.529177210903:14.8f} {a[3] / 0.529177210903:14.8f}")
    hs += ["", "$end", ""]
    open(f"{base}.hess", "w").write("\n".join(hs))


def flush(base, out, child):
    sys.stdout.write("\n".join(out) + "\n")
    sys.stdout.flush()
    if child:
        child.kill()


if __name__ == "__main__":
    main()
